    "@remotion/player": "^4.0.240",
    "@remotion/three": "^4.0.240",
    "postprocessing": "^6.36.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
