# API Key cho Multi-Agent Director (Gemini 2.5 Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Google Labs Flow (1.000 credits/tháng)
# Chế độ: veo-3-fast (20 credits/clip 8s) | veo-3.1-lite (10 credits/clip) | mock (chạy thử 0 tốn credit)
FLOW_MODEL_TIER=veo-3-fast
FLOW_SIMULATION_MODE=false

# Cấu hình phần cứng cho Dell Precision 7530 (Xeon E-2176M + Quadro P2000 4GB)
REMOTION_CONCURRENCY=3
REMOTION_GL_BACKEND=angle
ENABLE_NVENC=true
DCI_WIDTH=2048
DCI_HEIGHT=1080
CINEMA_FPS=24
