# NHÂN AI: Sử dụng trực tiếp phiên đăng nhập Google Antigravity CLI (agy auth login)
# KHÔNG CẦN CẤU HÌNH API KEY!
AI_ENGINE=antigravity-cli
ANTIGRAVITY_BINARY=agy
ANTIGRAVITY_PROXY_URL=http://127.0.0.1:8000

# Cấu hình Google Labs Flow (1.000 credits/tháng)
FLOW_MODEL_TIER=veo-3-fast
FLOW_SIMULATION_MODE=false

# Cấu hình phần cứng cho Dell Precision 7530 (Xeon E-2176M + Quadro P2000 4GB)
REMOTION_CONCURRENCY=3
REMOTION_GL_BACKEND=angle
ENABLE_NVENC=true
DCI_WIDTH=2048
DCI_HEIGHT=1080
CINEMA_FPS=24
